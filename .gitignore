# ═══════════════════════════════════════════
# Deal Hunter Bot — .gitignore
# ═══════════════════════════════════════════

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
venv/
.venv/
.pytest_cache/

# ── Secrets & Credentials (NEVER PUSH) ─────
.env
*.session
*.session-journal
userbot/extrape_session/
database/bot_data.db
*.db-shm
*.db-wal
auth_audit.log

# ── Environment / Config ────────────────────
.production

# ── Runtime Artifacts ───────────────────────
bot.log
temp_screenshots/

# ── IDE ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
