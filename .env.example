# Example .env - DO NOT COMMIT real secrets
# Run `python scripts/secure_local_secrets.py` to generate the two master keys
# outside the repository (Windows: %LOCALAPPDATA%\DealHunterBot\.env).
# API credentials may then be entered in the dashboard and are encrypted in SQLite.
API_ID=
API_HASH=
BOT_TOKEN=
EXTRAPE_AFFID=
EXTRAPE_PARAM1=
FLASK_SECRET_KEY=generate_at_least_32_random_characters
ENCRYPTION_KEY=generate_at_least_32_random_characters
